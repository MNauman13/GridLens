# Server-side URL; browser requests use the same-origin Next.js route.
GRIDLENS_API_URL=http://127.0.0.1:8000

# Optional standalone Python reference worker (one process, persistent SQLite).
GRIDLENS_LIVE_ASSETS=artifacts/i1
GRIDLENS_JOB_DB=reports/local/i1/jobs.sqlite3
# Opt in to checked SDPA only after its startup parity gate passes.
GRIDLENS_SDPA_ENABLED=0
