{
  "$defs": {
    "ArtifactFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "$ref": "#/$defs/ArtifactFile"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "kind": {
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": "gridlens_artifact_v1",
      "default": "gridlens_artifact_v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "files"
  ],
  "title": "ArtifactManifest",
  "type": "object"
}
