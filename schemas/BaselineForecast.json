{
  "$defs": {
    "InputWindow": {
      "additionalProperties": false,
      "properties": {
        "context_end_exclusive": {
          "format": "date-time",
          "title": "Context End Exclusive",
          "type": "string"
        },
        "context_start": {
          "format": "date-time",
          "title": "Context Start",
          "type": "string"
        },
        "contract_version": {
          "const": "gb_nd_day_ahead_v1",
          "default": "gb_nd_day_ahead_v1",
          "title": "Contract Version",
          "type": "string"
        },
        "demand_mw": {
          "items": {
            "type": "number"
          },
          "maxItems": 336,
          "minItems": 336,
          "title": "Demand Mw",
          "type": "array"
        },
        "evidence_mode": {
          "enum": [
            "retrospective_revised",
            "captured_availability"
          ],
          "title": "Evidence Mode",
          "type": "string"
        },
        "feature_snapshot_id": {
          "minLength": 1,
          "title": "Feature Snapshot Id",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "target_end_exclusive": {
          "format": "date-time",
          "title": "Target End Exclusive",
          "type": "string"
        },
        "target_start": {
          "format": "date-time",
          "title": "Target Start",
          "type": "string"
        }
      },
      "required": [
        "issued_at",
        "context_start",
        "context_end_exclusive",
        "target_start",
        "target_end_exclusive",
        "evidence_mode",
        "feature_snapshot_id",
        "demand_mw"
      ],
      "title": "InputWindow",
      "type": "object"
    },
    "PointForecast": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "gb_nd_day_ahead_v1",
          "default": "gb_nd_day_ahead_v1",
          "title": "Contract Version",
          "type": "string"
        },
        "feature_snapshot_id": {
          "minLength": 1,
          "title": "Feature Snapshot Id",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "prediction_mw": {
          "items": {
            "type": "number"
          },
          "maxItems": 48,
          "minItems": 48,
          "title": "Prediction Mw",
          "type": "array"
        }
      },
      "required": [
        "model_version",
        "feature_snapshot_id",
        "prediction_mw"
      ],
      "title": "PointForecast",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "evaluation_role": {
      "const": "point_validation",
      "default": "point_validation",
      "title": "Evaluation Role",
      "type": "string"
    },
    "forecast_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Forecast Id",
      "type": "string"
    },
    "inputs": {
      "$ref": "#/$defs/InputWindow"
    },
    "model_kind": {
      "enum": [
        "last_day",
        "weekly",
        "ridge"
      ],
      "title": "Model Kind",
      "type": "string"
    },
    "observed_mw": {
      "items": {
        "type": "number"
      },
      "maxItems": 48,
      "minItems": 48,
      "title": "Observed Mw",
      "type": "array"
    },
    "point": {
      "$ref": "#/$defs/PointForecast"
    },
    "schema_version": {
      "const": "gridlens_baseline_forecast_v1",
      "default": "gridlens_baseline_forecast_v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Sha256",
      "type": "array"
    },
    "truth_version": {
      "minLength": 1,
      "title": "Truth Version",
      "type": "string"
    },
    "validation_report_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Validation Report Id",
      "type": "string"
    }
  },
  "required": [
    "forecast_id",
    "inputs",
    "point",
    "model_kind",
    "observed_mw",
    "dataset_id",
    "source_sha256",
    "truth_version",
    "validation_report_id"
  ],
  "title": "BaselineForecast",
  "type": "object"
}
