{
  "name": "gridlens-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web"],
  "engines": {"node": ">=24"},
  "scripts": {
    "dev": "npm run dev --workspace @gridlens/web",
    "build": "npm run build --workspace @gridlens/web",
    "start": "npm run start --workspace @gridlens/web",
    "typecheck": "npm run typecheck --workspace @gridlens/web",
    "lint": "npm run lint --workspace @gridlens/web",
    "test:unit": "node --test tests/visual.test.cjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {"playwright": "1.64.1"}
}
