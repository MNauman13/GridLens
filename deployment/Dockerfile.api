FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 GRIDLENS_COOKIE_SECURE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN pip install --no-cache-dir uv==0.11.21 && uv sync --frozen --extra api --extra ml --no-dev
COPY scripts ./scripts
RUN useradd --uid 10001 --create-home gridlens && mkdir -p /app/reports/local && chown -R gridlens:gridlens /app/reports
USER gridlens
EXPOSE 8000
CMD [".venv/bin/python","-m","uvicorn","gridlens.api:app","--host","0.0.0.0","--port","8000"]
